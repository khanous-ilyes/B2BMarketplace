{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=YOUR_DB_HOST;Port=5432;Database=postgres;Username=YOUR_USERNAME;Password=YOUR_PASSWORD;SSL Mode=Require;Trust Server Certificate=true"
  },
  "Supabase": {
    "StorageUrl": "https://YOUR_PROJECT_ID.supabase.co/storage/v1",
    "S3Endpoint": "https://YOUR_PROJECT_ID.storage.supabase.co/storage/v1/s3",
    "AccessKey": "YOUR_SUPABASE_ACCESS_KEY",
    "SecretKey": "YOUR_SUPABASE_SECRET_KEY",
    "BucketName": "b2b-images",
    "Region": "eu-central-1"
  },
  "JwtSection": {
    "Key": "YOUR_SUPER_SECRET_JWT_KEY_MINIMUM_32_CHARS_LONG",
    "Issuer": "https://localhost:7193",
    "Audience": "https://localhost:7193"
  },
  "Firebase": {
    "CredentialsPath": "serviceAccountKey.json",
    "StorageBucket": "YOUR_FIREBASE_STORAGE_BUCKET.app"
  },
    "EmailSettings": {
        "SmtpServer": "smtp.gmail.com",
        "Port": "587",
        "SenderEmail": "YOUR_EMAIL@gmail.com",
        "SenderName": "B2B Marketplace",
        "Username": "YOUR_EMAIL@gmail.com",
        "Password": "YOUR_APP_PASSWORD",
        "EnableSsl": "true"
    }
}